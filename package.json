{
  "name": "@arraypress/waveform-tracker",
  "version": "1.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Simple analytics tracking for WaveformPlayer",
  "type": "module",
  "main": "dist/waveform-tracker.esm.js",
  "unpkg": "dist/waveform-tracker.min.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/waveform-tracker.esm.js",
      "default": "./dist/waveform-tracker.esm.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:iife && npm run build:esm && npm run build:min && npm run build:types",
    "build:iife": "esbuild src/index.ts --bundle --format=iife --outfile=dist/waveform-tracker.js",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --outfile=dist/waveform-tracker.esm.js",
    "build:min": "esbuild src/index.ts --bundle --format=iife --minify --outfile=dist/waveform-tracker.min.js",
    "dev": "esbuild src/index.ts --bundle --format=iife --outfile=dist/waveform-tracker.js --watch",
    "serve": "npx http-server -p 8000",
    "prepublishOnly": "npm test && npm run build",
    "build:types": "rm -rf types && tsc -p tsconfig.build.json",
    "lint": "biome lint",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "audio",
    "analytics",
    "tracking",
    "waveform",
    "player",
    "metrics"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaveformPlayer/waveform-tracker.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": [
    "./dist/waveform-tracker.esm.js",
    "./dist/waveform-tracker.js",
    "./dist/waveform-tracker.min.js",
    "./src/index.ts"
  ],
  "peerDependencies": {
    "@arraypress/waveform-player": "^1.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
